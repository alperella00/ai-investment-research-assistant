# ─────────────────────────────────────────────
# Yatırım Asistanı — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun:
#   cp .env.example .env
# ─────────────────────────────────────────────

# Telegram bot token (BotFather'dan alınır)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz

# Anthropic / Claude API anahtarı
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Opsiyonel) CoinGecko Pro API anahtarı — boş bırakılırsa ücretsiz uç nokta kullanılır
COINGECKO_API_KEY=

# (Opsiyonel) Log seviyesi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
